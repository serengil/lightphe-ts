{
  "name": "lightphe-ts",
  "version": "0.0.1",
  "description": "A Lightweight Partially Homomorphic Encryption Library for TypeScript and JavaScript",
  "author": "Sefik Serengil",
  "license": "MIT",
  "homepage": "https://github.com/serengil/lightphe-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serengil/lightphe-ts.git"
  },
  "bugs": {
    "url": "https://github.com/serengil/lightphe-ts/issues"
  },
  "keywords": [
    "homomorphic-encryption",
    "partially-homomorphic-encryption",
    "cryptography",
    "paillier",
    "elgamal",
    "rsa",
    "elliptic-curve",
    "privacy",
    "typescript"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist coverage",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:types && node scripts/postbuild.mjs",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:types": "tsc -p tsconfig.types.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md,yml}\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.6",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
